{
  "mcpServers": {
    "mobbin": {
      "url": "https://api.mobbin.com/mcp",
      "auth": "oauth",
      "lifecycle": "lazy"
    },
    "atlassian": {
      "url": "https://mcp.atlassian.com/v1/mcp",
      "auth": "oauth",
      "lifecycle": "lazy"
    },
    "gitlab": {
      "command": "npx",
      "args": [
        "-y",
        "@zereight/mcp-gitlab@2.1.55"
      ],
      "env": {
        "GITLAB_API_URL": "https://gitlab.tripster.ru/api/v4",
        "GITLAB_PERSONAL_ACCESS_TOKEN": "!sh -c 'set -a; . \"$HOME/.config/tripster/mcp.env\"; set +a; printf \"%s\" \"$GITLAB_PERSONAL_ACCESS_TOKEN\"'",
        "GITLAB_PERMISSION_MODE": "readonly"
      },
      "lifecycle": "lazy"
    },
    "figma": {
      "url": "https://mcp.figma.com/mcp",
      "auth": "oauth",
      "lifecycle": "lazy",
      "exposeResources": true,
      "directTools": false
    },
    "slack": {
      "url": "https://mcp.slack.com/mcp",
      "auth": "oauth",
      "oauth": {
        "clientId": "38851928391.11679702187766",
        "scope": "channels:history channels:read groups:history groups:read files:read im:history mpim:history mpim:read search:read.private search:read.public search:read.files search:read.im search:read.mpim search:read.users users:read users:read.email chat:write im:write",
        "redirectUri": "http://localhost:3118/callback"
      },
      "lifecycle": "lazy"
    },
    "gmail": {
      "command": "npx",
      "args": [
        "-y",
        "@gongrzhe/server-gmail-autoauth-mcp"
      ],
      "lifecycle": "lazy"
    },
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest"
      ],
      "lifecycle": "lazy"
    },
    "adaptive-lms": {
      "url": "http://localhost:3001/api/mcp",
      "headers": {
        "Authorization": "Bearer ${ADAPTIVE_LMS_TOKEN}"
      },
      "lifecycle": "lazy"
    }
  }
}
